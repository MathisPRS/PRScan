{
  "expo": {
    "name": "PRScan",
    "slug": "prscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prscan.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PRScan needs camera access to scan documents.",
        "NSPhotoLibraryUsageDescription": "PRScan needs photo library access to import images.",
        "NSPhotoLibraryAddUsageDescription": "PRScan needs permission to save scanned documents to your photo library."
      }
    },
    "android": {
      "package": "com.prscan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E53935"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-media-library",
      [
        "expo-image-picker",
        {
          "photosPermission": "PRScan needs access to your photos to create PDFs.",
          "cameraPermission": "PRScan needs camera access to scan documents."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "PRScan needs camera access to automatically detect and scan documents."
        }
      ]
    ],
    "scheme": "prscan"
  }
}
